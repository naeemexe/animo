# Animo — server-side configuration.
#
# Copy to .env (gitignored) on whichever machine runs the backend:
#
#   cp .env.example .env
#
# Browser-side settings (Gemini key or proxy URL, ElevenLabs, the motion
# server URL) live in local-config.js instead — see local-config.example.js.

# ---- Motion server (backend/motion_server.py) ------------------------------
# Runs on a GPU machine — a RunPod pod or a Vultr Cloud GPU instance.
# Hugging Face token with access to meta-llama/Meta-Llama-3-8B-Instruct
# (Kimodo's text encoder).
HF_TOKEN=
# Where the Kimodo repository and the Hugging Face cache live on that machine.
KIMODO_DIR=/workspace/kimodo
HF_HOME=/workspace/hf_cache
# Comma-separated origins allowed to call the server ("*" for any).
MOTION_CORS_ORIGINS=*

# ---- Gemini proxy (backend/gemini_proxy.py, optional) ----------------------
# Uses Application Default Credentials; no API key needed.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# ---- GPU hosting ------------------------------------------------------------
# The motion server is the same on either host; these are only needed if you
# script provisioning. See README -> Deploying the motion server.
RUNPOD_API_KEY=
VULTR_API_KEY=

# ---- Auth0 (planned) --------------------------------------------------------
# Sign-in for the app; also used to verify tokens on the backend.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# ---- TigerData (planned) ----------------------------------------------------
# Postgres (Tiger Cloud) connection string for user profiles and generation
# history.
TIGERDATA_DATABASE_URL=

# ---- Backboard (planned) ----------------------------------------------------
# Persistent per-user memory (learned skills, saved scenes).
BACKBOARD_API_KEY=
